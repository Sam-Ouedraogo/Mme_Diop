---
import { getEntry } from 'astro:content';
const siteData = await getEntry('settings', 'site');
const site = siteData?.data;
const year = new Date().getFullYear();
---

<footer class="bg-ink border-t border-gold/10 py-16">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">

      <!-- Brand -->
      <div>
        <a href="#hero" class="block mb-4">
          <span class="font-display text-2xl font-light tracking-widest text-gold">
            {site?.businessName ?? 'Bijoux Dorée'}
          </span>
        </a>
        <p class="text-cream/40 text-sm leading-relaxed font-light">
          Bijoux artisanaux d'Afrique de l'Ouest, créés avec intention et portés avec fierté.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-xs tracking-[0.3em] uppercase text-gold/60 mb-6">Navigation</h3>
        <ul class="space-y-3">
          {[
            { href: '#collections', label: 'Collections' },
            { href: '#about', label: 'Notre Histoire' },
            { href: '#gallery', label: 'Galerie' },
            { href: '#testimonials', label: 'Avis' },
            { href: '#contact', label: 'Contact' },
            { href: '/admin', label: 'Connexion Propriétaire' },
          ].map(({ href, label }) => (
            <li>
              <a
                href={href}
                class="text-sm text-cream/40 hover:text-gold transition-colors duration-300"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact quick -->
      <div>
        <h3 class="text-xs tracking-[0.3em] uppercase text-gold/60 mb-6">Contact</h3>
        <div class="space-y-3">
          <p class="text-sm text-cream/40">
            <span class="text-cream/60">WhatsApp :</span> {site?.whatsapp}
          </p>
          <p class="text-sm text-cream/40">
            <span class="text-cream/60">Adresse :</span> {site?.address}
          </p>
          {site?.email && (
            <p class="text-sm text-cream/40">
              <span class="text-cream/60">E-mail :</span>{' '}
              <a href={`mailto:${site.email}`} class="hover:text-gold transition-colors duration-300">
                {site.email}
              </a>
            </p>
          )}
        </div>

        <!-- Social -->
        <div class="flex gap-3 mt-6">
          {site?.instagram && (
            <a
              href={`https://instagram.com/${site.instagram}`}
              target="_blank"
              rel="noopener noreferrer"
              class="text-cream/30 hover:text-gold transition-colors duration-300"
              aria-label="Instagram"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
              </svg>
            </a>
          )}
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-gold/10 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-cream/30 text-xs tracking-wider">
        &copy; {year} {site?.businessName ?? 'Bijoux Dorée'}. Tous droits réservés.
      </p>
      <p class="text-cream/20 text-xs">
        Fabriqué avec soin en Afrique de l'Ouest
      </p>
    </div>
  </div>
</footer>
